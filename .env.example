DATABASE_URL=postgresql+psycopg://savestock_app:CHANGE_THIS_PASSWORD@localhost:5432/savestock

# Runtime configuration
POSTGRES_DB=savestock
POSTGRES_USER=savestock
# Compose DATABASE_URL embeds this value; use a long random hex string.
POSTGRES_PASSWORD=
SAVESTOCK_ENV=development
# Production secrets: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SAVESTOCK_SECRET_KEY=
SAVESTOCK_COOKIE_SECURE=false
# Comma-separated host names (required when SAVESTOCK_ENV=production)
SAVESTOCK_ALLOWED_HOSTS=
# HTTPS profile: replace with the domain whose DNS points to this server.
SAVESTOCK_DOMAIN=stock.example.com
# Keep the proxy IP inside this subnet; choose a subnet that does not overlap
# with existing Docker or server networks.
SAVESTOCK_PROXY_SUBNET=172.29.0.0/24
SAVESTOCK_PROXY_IP=172.29.0.2
FORWARDED_ALLOW_IPS=127.0.0.1,172.29.0.2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
# Generate with `python -m app.backup generate-key`; store separately from backups.
BACKUP_ENCRYPTION_KEY=

# PayTR iFrame API — credentials from PayTR Merchant Panel
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Must be an address PayTR can reach; localhost does not work for notifications.
PAYTR_PUBLIC_URL=https://your-public-savestock-domain.example
PAYTR_TEST_MODE=1
# For local testing, set the public IPv4 address PayTR expects.
PAYTR_TEST_USER_IP=
